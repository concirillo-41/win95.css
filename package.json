{
  "name": "win95.css",
  "version": "0.1.0",
  "description": "A Windows 95 interface kit for the web: windows, taskbar, Start menu and every classic control in one stylesheet, plus an optional tiny window manager.",
  "keywords": [
    "css",
    "windows-95",
    "win95",
    "retro",
    "ui-kit",
    "design-system",
    "90s"
  ],
  "license": "MIT",
  "author": "Con Cirillo <howdy@concirillo.com> (https://concirillo.com)",
  "homepage": "https://github.com/concirillo-41/win95.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concirillo-41/win95.css.git"
  },
  "style": "dist/win95.css",
  "main": "dist/win95.js",
  "unpkg": "dist/win95.css",
  "jsdelivr": "dist/win95.css",
  "files": [
    "dist",
    "src",
    "fonts",
    "types",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "test": "npm run build && npm run check"
  },
  "devDependencies": {
    "opentype.js": "^1.3.4",
    "playwright": "^1.56.1",
    "wawoff2": "^2.0.1"
  },
  "types": "types/win95.d.ts",
  "exports": {
    ".": {
      "types": "./types/win95.d.ts",
      "style": "./dist/win95.css",
      "default": "./dist/win95.js"
    },
    "./win95.css": "./dist/win95.css",
    "./win95.js": "./dist/win95.js",
    "./dist/*": "./dist/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/win95.js"
  ],
  "engines": {
    "node": ">=18"
  }
}
